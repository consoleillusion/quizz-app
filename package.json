{
  "name": "quizes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "db:init": "bun src/db/init.ts",
    "db:sql": "bun src/db/init.ts --print",
    "test": "bun test src",
    "start": "HOST=0.0.0.0 PORT=${PORT:-4359} bun ./dist/server/entry.mjs",
    "db:migrate": "bun src/db/migrate.ts",
    "db:backup": "bun src/db/backup.ts"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@astrojs/node": "^11.1.9",
    "@astrojs/svelte": "^9.1.2",
    "@serenity-kit/opaque": "^1.1.0",
    "@tursodatabase/database": "^0.8.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.4",
    "change-case": "^5.4.4",
    "elysia": "^1.4.30",
    "http-status-codes": "^2.3.0",
    "markdown-it": "^15.0.3",
    "morphicons": "^2.0.2",
    "nunjucks": "^3.2.4",
    "ramda": "^0.32.0",
    "svelte": "^5.57.3",
    "uplot": "^1.6.32"
  }
}
