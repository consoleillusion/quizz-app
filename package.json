{
  "name": "quizes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "db:init": "bun src/db/init.ts",
    "db:sql": "bun src/db/init.ts --print",
    "test": "bun test src",
    "start": "HOST=0.0.0.0 PORT=${PORT:-4359} bun ./dist/server/entry.mjs",
    "db:migrate": "bun src/db/migrate.ts",
    "db:backup": "bun src/db/backup.ts",
    "complexity": "node_modules/fta-cli/index.js . --json | bun node_modules/@toon-format/cli/bin/toon.mjs",
    "complexity:save": "bun run test:complexity > analysis.toon",
    "lint": "bunx biome check --write",
    "commit": "git commit -m"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@astrojs/node": "^11.1.9",
    "@astrojs/svelte": "^9.1.2",
    "@consoleillusion/zamda": "^0.0.972",
    "@libsql/client": "^0.18.0",
    "@serenity-kit/opaque": "^1.1.0",
    "@toon-format/cli": "^4.4.0",
    "@toon-format/toon": "^4.4.0",
    "@tursodatabase/database": "^0.8.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.4",
    "bits-ui": "^2.20.4",
    "change-case": "^5.4.4",
    "dotenv": "^18.0.9",
    "fta-cli": "^3.1.0",
    "http-status-codes": "^2.3.0",
    "lucide": "^1.68.0",
    "markdown-it": "^15.0.3",
    "morphicons": "^2.0.2",
    "nunjucks": "^3.2.4",
    "ramda": "^0.32.0",
    "svelte": "^5.57.3",
    "svelte-dnd-action": "^0.9.80",
    "ts-japi": "^1.12.6",
    "tweetnacl": "^1.0.3",
    "uplot": "^1.6.32",
    "wider-format": "github:consoleillusion/formatter-ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "drizzle-kit": "^1.0.0-rc.5",
    "tsx": "^4.23.15"
  }
}
