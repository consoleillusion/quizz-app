---
// /user: accounts.
//   GET   HTML: the sign-up form.  JSON: the logged-in user, or 401.
//   POST  create an account {username, password, email?}, then log in.
//         Form: 303 to ?next (default /quiz).  JSON: 201 with the user.
import Layout from "../layouts/Layout.astro"
import {HttpError, json, jsonError, methodNotAllowed, seeOther, wantsJson} from "../lib/rest.ts"
import {register, safeNext, startSession} from "../lib/auth.ts"

const allow = ["GET", "POST"]
const {request, url, cookies, locals} = Astro
if (!allow.includes(request.method)) return methodNotAllowed(allow)
const asJson = wantsJson(request)
const secure = url.protocol === "https:"

let errors: {field: string, message: string}[] = []
let values: Record<string, string> = {}
if (request.method === "POST") {
  const type = request.headers.get("content-type") ?? ""
  values = type.includes("json") ? await request.json().catch(() => ({})) : Object.fromEntries(await request.formData()) as Record<string, string>
  try {
    const user = await register(values)
    await startSession(cookies, user, secure)
    return asJson ? json(user, 201, {location: "/user"}) : seeOther(safeNext(values.next))
  } catch (e) {
    if (!(e instanceof HttpError)) throw e
    if (asJson) return jsonError(e)
    errors = e.errors.length ? e.errors : [{field: "", message: e.message}]
    Astro.response.status = e.status
  }
} else if (asJson) {
  return locals.user ? json(locals.user) : jsonError(new HttpError(401, "Not logged in"))
}

const errorFor = (field: string) =>
  // Purpose: the error messages for one form field, joined
  errors.filter(e => e.field === field).map(e => e.message).join("; ")
const next = values.next ?? url.searchParams.get("next") ?? "/quiz"
---
<Layout title="Sign up">
  <h1>Sign up</h1>
  {locals.user && <p>You're logged in as <strong>{locals.user.username}</strong>. <a href="/session">Log out</a> to create another account.</p>}
  <p>Your answers are saved to your account, so your progress follows you between devices.</p>
  <form method="post" action="/user">
    <input type="hidden" name="next" value={next} />
    {errorFor("") && <p class="bad">{errorFor("")}</p>}
    <p>
      <label for="username">Username</label>
      <input id="username" name="username" required minlength="2" maxlength="32" pattern="[A-Za-z0-9._\-]+" autocomplete="username" value={values.username ?? ""} />
      <small>Letters, digits, dot, dash or underscore.</small>
      {errorFor("username") && <small class="bad">{errorFor("username")}</small>}
    </p>
    <p>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" />
      <small>At least 8 characters.</small>
      {errorFor("password") && <small class="bad">{errorFor("password")}</small>}
    </p>
    <p>
      <label for="email">Email (optional)</label>
      <input id="email" name="email" type="email" autocomplete="email" value={values.email ?? ""} />
      {errorFor("email") && <small class="bad">{errorFor("email")}</small>}
    </p>
    <button>Create account</button>
  </form>
  <p>Already have an account? <a href={`/session?next=${encodeURIComponent(next)}`}>Log in</a></p>
</Layout>
