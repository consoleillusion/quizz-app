---
// /user: sign up. OPAQUE runs in the browser (src/lib/account.ts); the password never reaches the server.
import Button from "wacss/components/Button/Button.svelte"
import Notice from "wacss/components/Notice/Notice.svelte"
import TextInput from "wacss/components/TextInput/TextInput.svelte"
import Layout from "../layouts/Layout.astro"
import { safeNext } from "../lib/next.ts"

const next = safeNext(Astro.url.searchParams.get("next"))
---
<Layout title="Sign up">
  <h1>Sign up</h1>
  <p data-signed-in hidden>You're logged in as <strong data-username></strong>. <a href="/session">Log out</a> to create another account.</p>
  <p>Answers you've already given in this browser move into your new account, and from then on your progress follows you between devices.</p>
  <noscript><Notice variant="danger" role="alert" text="Signing up needs JavaScript: your password is processed in the browser and never sent to the server." /></noscript>
  <form class="stack" data-signup data-next={next}>
    <Notice variant="danger" role="alert" data-error hidden />
    <TextInput id="username" name="username" label="Username" help="Letters, digits, dot, dash or underscore." required minlength={2} maxlength={32} pattern="[A-Za-z0-9._\-]+" autocomplete="username" />
    <!-- No name attribute: the password is never submitted with the form. -->
    <TextInput id="password" type="password" label="Password" help="At least 8 characters." required minlength={8} autocomplete="new-password" />
    <div class="cluster"><Button type="submit" variant="primary" label="Create account" /></div>
  </form>
  <p>Already have an account? <a href={`/session?next=${encodeURIComponent(next)}`}>Log in</a></p>
</Layout>
<script>
  import { signedInUsername, signUp } from "../lib/account.ts"

  const username = signedInUsername()
  if (username) {
    document.querySelector<HTMLElement>("[data-signed-in]")!.hidden = false
    document.querySelector("[data-username]")!.textContent = username
  }
  const form = document.querySelector<HTMLFormElement>("[data-signup]")!
  const error = form.querySelector<HTMLElement>("[data-error]")!
  form.addEventListener("submit", async event => {
    event.preventDefault()
    const button = form.querySelector("button")!
    button.setAttribute("aria-busy", "true"); button.disabled = true; error.textContent = ""; error.hidden = true
    const value = (id: string) => (form.querySelector(`#${id}`) as HTMLInputElement).value
    try {
      await signUp({ username: value("username"), password: value("password") })
      location.assign(form.dataset.next!)
    } catch (e: any) {
      error.textContent = e.message
      error.hidden = false
      button.removeAttribute("aria-busy"); button.disabled = false
    }
  })
</script>
