---
// /: the exams (tags of type exam) as cards, each linking to its question pool. JSON with ?format=json.
import Card from "wacss/components/Card/Card.astro"
import Layout from "../layouts/Layout.astro"
import { listExams } from "../lib/exams.ts"
import { json, wantsJson } from "../lib/http.ts"

const exams = await listExams(Astro.request)
// The list changes rarely; let the CDN serve it for five minutes.
Astro.response.headers.set("cache-control", "public, s-maxage=300, stale-while-revalidate=3600")
if (wantsJson(Astro.request)) return json({ items: exams })
---
<Layout title="Exams">
  <h1>Exams</h1>
  <section class="grid">
    {exams.map(exam => (
      <Card figure={{ component: "Stat", data: { value: exam.question_count, label: "questions" } }}>
        <h3><a href={exam.url}>{exam.description || exam.name}</a></h3>
        <small>{exam.name} · {exam.domain_count} domains</small>
      </Card>
    ))}
  </section>
</Layout>
