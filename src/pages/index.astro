---
// Home: practice quizzes and topic sets, with progress read from IndexedDB.
import Layout from "../layouts/Layout.astro"
import {getSets} from "../lib/data.ts"
import {exams} from "../lib/exams.ts"

const sets = await getSets()
const groups = [
  {title: "Practice quizzes", note: "Blueprint-weighted, across all five domains.", sets: sets.filter(s => s.tags.includes("practice"))},
  {title: "Topic sets", note: "Deep dives on one technology.", sets: sets.filter(s => s.tags.includes("topic"))},
]
const exam = exams[sets[0]?.exam]?.name ?? "ENAUTO"
---
<Layout title="Question sets">
  <h1>{exam} practice</h1>
  <p>Pick a set. Your answers are saved in this browser, so you can stop and pick up where you left off.</p>
  {groups.map(group => (
    <section>
      <h2>{group.title}</h2>
      <p>{group.note}</p>
      <ul>
        {group.sets.map(set => (
          <li>
            <a href={`/sets/${set.slug}/`}><strong>{set.title}</strong></a>
            · {set.question_count} questions
            · <span data-progress={set.id} data-total={set.question_count}>not started</span>
            <br /><small>{set.description}</small>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  import {loadAnswers} from "../lib/progress.ts"

  const showProgress = async (el: HTMLElement) => {
    // Purpose: fill one set's progress line from its saved answers
    const answers = await loadAnswers(el.dataset.progress!)
    if (!answers.length) return
    const right = answers.filter(a => a.correct).length
    el.textContent = `${answers.length}/${el.dataset.total} answered, ${right} correct`
  }
  document.querySelectorAll<HTMLElement>("[data-progress]").forEach(showProgress)
</script>
