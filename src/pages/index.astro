---
// /: the exams (tags of type exam) as cards, each linking to its question pool. JSON with ?format=json.
import Layout from "../layouts/Layout.astro"
import { listExams } from "../lib/exams.ts"
import { json, wantsJson } from "../lib/rest.ts"

const exams = await listExams()
if (wantsJson(Astro.request)) return json({ items: exams })
---
<Layout title="Exams">
  <h1>Exams</h1>
  <section class="cards">
    {exams.map(exam => (
      <article>
        <h3><a href={exam.url}>{exam.description || exam.name}</a></h3>
        <small>{exam.name} · {exam.question_count} questions · {exam.domain_count} domains</small>
      </article>
    ))}
  </section>
</Layout>
