---
// /session: logging in and out.
//   GET     HTML: login form, or who you are with a log-out button.  JSON: the session's user, or 401.
//   POST    log in {username, password}.  Form: 303 to ?next.  JSON: 201 with the user.
//   DELETE  log out (forms send POST with _method=DELETE).  Form: 303 to /session.  JSON: 204.
import Layout from "../layouts/Layout.astro"
import {HttpError, effectiveMethod, json, jsonError, methodNotAllowed, seeOther, wantsJson} from "../lib/rest.ts"
import {authenticate, endSession, safeNext, startSession} from "../lib/auth.ts"

const allow = ["GET", "POST", "DELETE"]
const {request, url, cookies, locals} = Astro
const method = await effectiveMethod(request)
if (!allow.includes(method)) return methodNotAllowed(allow)
const asJson = wantsJson(request)

let error = ""
let values: Record<string, string> = {}
if (method === "DELETE") {
  await endSession(cookies)
  return asJson ? new Response(null, {status: 204}) : seeOther("/session")
}
if (method === "POST") {
  const type = request.headers.get("content-type") ?? ""
  values = type.includes("json") ? await request.json().catch(() => ({})) : Object.fromEntries(await request.formData()) as Record<string, string>
  try {
    const user = await authenticate(values.username, values.password)
    await endSession(cookies)
    await startSession(cookies, user, url.protocol === "https:")
    return asJson ? json(user, 201, {location: "/session"}) : seeOther(safeNext(values.next))
  } catch (e) {
    if (!(e instanceof HttpError)) throw e
    if (asJson) return jsonError(e)
    error = e.message
    Astro.response.status = e.status
  }
} else if (asJson) {
  return locals.user ? json(locals.user) : jsonError(new HttpError(401, "Not logged in"))
}
const next = values.next ?? url.searchParams.get("next") ?? "/quiz"
---
<Layout title={locals.user ? "Account" : "Log in"}>
  {locals.user ? (
    <>
      <h1>Account</h1>
      <p>You're logged in as <strong>{locals.user.username}</strong>. Your answers sync to this account.</p>
      <form method="post" action="/session">
        <input type="hidden" name="_method" value="DELETE" />
        <button>Log out</button>
      </form>
    </>
  ) : (
    <>
      <h1>Log in</h1>
      <form method="post" action="/session">
        <input type="hidden" name="next" value={next} />
        {error && <p class="bad">{error}</p>}
        <p><label for="username">Username</label>
          <input id="username" name="username" required autocomplete="username" value={values.username ?? ""} /></p>
        <p><label for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" /></p>
        <button>Log in</button>
      </form>
      <p>No account? <a href={`/user?next=${encodeURIComponent(next)}`}>Sign up</a></p>
    </>
  )}
</Layout>
