---
// /session: logging in and out.
//   GET     HTML: login form, or who you are with a log-out button.  JSON: the session's user, or 401.
//   POST    OPAQUE login, JSON only (the page's script drives it; the password never leaves the browser):
//           1. {username, startLoginRequest, publicKey}   → {loginId, loginResponse}
//           2. {loginId, finishLoginRequest, proof}       → 201 with the user plus serverPublicKey and serverProof; starts a session
//   DELETE  log out (forms send POST with _method=DELETE).  Form: 303 to /session.  JSON: 204.
import Button from "wacss/components/Button/Button.svelte"
import Notice from "wacss/components/Notice/Notice.svelte"
import TextInput from "wacss/components/TextInput/TextInput.svelte"
import Layout from "../layouts/Layout.astro"
import { endSession, finishLogin, safeNext, startLogin, startSession } from "../lib/auth.ts"
import {
  effectiveMethod,
  HttpError,
  json,
  jsonError,
  methodNotAllowed,
  seeOther,
  wantsJson,
} from "../lib/rest.ts"

const allow = ["GET", "POST", "DELETE"]
const { request, url, cookies, locals } = Astro
const method = await effectiveMethod(request)
if (!allow.includes(method)) return methodNotAllowed(allow)

if (method === "DELETE") {
  await endSession(cookies)
  return wantsJson(request) ? new Response(null, { status: 204 }) : seeOther("/session")
}
if (method === "POST") {
  try {
    const input = await request.json().catch(() => ({}))
    if (!("finishLoginRequest" in input)) return json(await startLogin(input))
    const { user, publicKey, serverKey, serverProof } = await finishLogin(input)
    await endSession(cookies)
    await startSession(cookies, user, publicKey, serverKey, url.protocol === "https:")
    return json({ ...user, serverPublicKey: serverKey.jwk, serverProof }, 201, { location: "/session" })
  } catch (e) {
    if (!(e instanceof HttpError)) throw e
    return jsonError(e)
  }
}
if (wantsJson(request))
  return locals.user ? json(locals.user) : jsonError(new HttpError(401, "Not logged in"))
const next = url.searchParams.get("next") ?? "/quiz"
---
<Layout title={locals.user ? "Account" : "Log in"}>
  {locals.user ? (
    <>
      <h1>Account</h1>
      <p>You're logged in as <strong>{locals.user.username}</strong>. Your answers sync to this account.</p>
      <form method="post" action="/session">
        <input type="hidden" name="_method" value="DELETE" />
        <Button type="submit" label="Log out" />
      </form>
    </>
  ) : (
    <>
      <h1>Log in</h1>
      <noscript><Notice variant="danger" role="alert" text="Logging in needs JavaScript: your password is processed in the browser and never sent to the server." /></noscript>
      <form class="stack" data-login data-next={safeNext(next)}>
        <Notice variant="danger" role="alert" data-error hidden />
        <TextInput id="username" name="username" label="Username" required autocomplete="username" />
        <!-- No name attribute: the password is never submitted with the form. -->
        <TextInput id="password" type="password" label="Password" required autocomplete="current-password" />
        <div class="cluster"><Button type="submit" variant="primary" label="Log in" /></div>
      </form>
      <p>No account? <a href={`/user?next=${encodeURIComponent(next)}`}>Sign up</a></p>
    </>
  )}
</Layout>

<script>
  import {logIn} from "../lib/opaque-client.ts"

  const form = document.querySelector<HTMLFormElement>("[data-login]")
  form?.addEventListener("submit", async event => {
    // Purpose: log in with OPAQUE, then go on to where the visitor was heading
    event.preventDefault()
    const button = form.querySelector("button")!, error = form.querySelector<HTMLElement>("[data-error]")!
    button.setAttribute("aria-busy", "true"); button.disabled = true; error.textContent = ""; error.hidden = true
    const value = (id: string) => (form.querySelector(`#${id}`) as HTMLInputElement).value
    try {
      await logIn({username: value("username"), password: value("password")})
      location.assign(form.dataset.next!)
    } catch (e: any) {
      error.textContent = e.message
      error.hidden = false
      button.removeAttribute("aria-busy"); button.disabled = false
    }
  })
</script>
