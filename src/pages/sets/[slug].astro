---
// One page per question set; the quiz itself is a client-only Svelte island.
import Layout from "../../layouts/Layout.astro"
import Quiz from "../../components/Quiz.svelte"
import {getSets, getQuestions} from "../../lib/data.ts"

export async function getStaticPaths() {
  // Purpose: build a page for every question set, with its questions as props
  const sets = await getSets()
  return Promise.all(sets.map(async set => ({params: {slug: set.slug}, props: {set, questions: await getQuestions(set.id)}})))
}

const {set, questions} = Astro.props
const quizSet = {id: set.id, slug: set.slug, title: set.title, randomize_question_order: set.randomize_question_order, randomize_option_order: set.randomize_option_order}
---
<Layout title={set.title} description={set.description}>
  <p><a href="/">← All sets</a></p>
  <h1>{set.title}</h1>
  <p>{set.description}</p>
  <Quiz client:only="svelte" set={quizSet} questions={questions} />
  <noscript><p>This quiz needs JavaScript.</p></noscript>
</Layout>
