---
import Quiz from "../../components/Quiz.svelte"
// /quiz/<slug or id>: one quiz.
//   GET  HTML: the quiz player.  JSON: the quiz with its questions (stored form, no rendering).
import Layout from "../../layouts/Layout.astro"
import { getQuestions, getQuiz, withRendering } from "../../lib/quizzes.ts"
import { HttpError, json, jsonError, methodNotAllowed, wantsJson } from "../../lib/rest.ts"

const allow = ["GET"]
const { request, params } = Astro
if (!allow.includes(request.method)) return methodNotAllowed(allow)
const asJson = wantsJson(request)

let quiz: any
try {
  quiz = await getQuiz(params.key!)
} catch (e) {
  if (!(e instanceof HttpError)) throw e
  if (asJson) return jsonError(e)
  Astro.response.status = e.status
}
const questions = quiz ? await getQuestions(quiz.id) : []
if (asJson) return json({ ...quiz, questions })

const player = quiz && {
  id: quiz.id,
  slug: quiz.slug,
  title: quiz.title,
  randomize_question_order: quiz.randomize_question_order,
  randomize_option_order: quiz.randomize_option_order,
}
---
<Layout title={quiz?.title ?? "Quiz not found"} description={quiz?.description}>
  <p><a href="/quiz">← All quizzes</a></p>
  {quiz ? (
    <>
      <h1>{quiz.title}</h1>
      <p>{quiz.description} <small><a href={`/quiz/${quiz.slug}?format=json`}>JSON</a></small></p>
      {questions.length
        ? <Quiz client:only="svelte" quiz={player} questions={questions.map(withRendering)} />
        : <p>This quiz has no questions yet.</p>}
      <noscript><p>This quiz needs JavaScript.</p></noscript>
    </>
  ) : (
    <>
      <h1>Quiz not found</h1>
      <p>There's no quiz called <code>{params.key}</code>.</p>
    </>
  )}
</Layout>
