---
// Page shell: Sakura dark for global styling, plus a few shared feedback classes.
interface Props { title: string, description?: string }
const {title, description = "ENAUTO 300-435 practice quizzes"} = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sakura.css/css/sakura-dark.css" />
    <title>{title} · ENAUTO Quiz</title>
  </head>
  <body>
    <header><a href="/">ENAUTO Quiz</a></header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  /* Minimal additions to Sakura: feedback colours, preserved line breaks, option rows. */
  :root { --ok: #6fd08f; --bad: #ff8a80; }
  .pre { white-space: pre-wrap; }
  .ok { color: var(--ok); }
  .bad { color: var(--bad); }
  label.option { display: block; padding: 0.4em 0; font-weight: normal; }
  label.option.ok, label.option.bad, tr.ok, tr.bad, li.ok, li.bad { font-weight: bold; }
  fieldset { border: 0; padding: 0; margin: 0 0 1em; }
  fieldset:disabled { opacity: 1; }
  legend { font-size: 0.9em; opacity: 0.8; }
  select.slot { width: auto; display: inline; padding: 0 0.2em; margin: 0; font: inherit; }
  select.slot.ok { outline: 2px solid var(--ok); }
  select.slot.bad { outline: 2px solid var(--bad); }
  button.small { padding: 0.1em 0.6em; margin-left: 0.3em; }
  button.link { background: none; border: 0; padding: 0; color: inherit; text-decoration: underline; cursor: pointer; }
  nav.bar { display: flex; flex-wrap: wrap; gap: 0.5em; align-items: center; }
  nav.bar select { width: auto; margin: 0; }
  progress { width: 100%; }
  pre { overflow-x: auto; }
</style>
