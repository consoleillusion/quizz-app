---
// Page shell: Pico CSS styles plain HTML; a few lines below add answer feedback colours.
interface Props { title: string, description?: string }
const {title, description = "Cisco certification practice quizzes"} = Astro.props
const user = Astro.locals.user
const next = encodeURIComponent(Astro.url.pathname)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.min.css" />
    <!--
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css" integrity="sha384-kj0X2NG2KHBie8Tq8fH1kxnyWM9XsXQpq7XdwbKmFKjwwaXGKBlB2Klu3VOltSFx" crossorigin="anonymous">
    -->
    <script is:inline>
      // Apply the saved theme before first paint; Pico follows the system setting when none is saved.
      try { const theme = localStorage.getItem("theme"); if (theme) document.documentElement.dataset.theme = theme } catch {}
    </script>
    <title>{title} · Exam Practice</title>
  </head>
  <body data-user-id={user?.id}>
    <header class="container">
      <nav>
        <ul><li><a href="/"><strong>Exam Practice</strong></a></li></ul>
        <ul>
          <li><a href="/quiz">Quizzes</a></li>
          <li><a href="/dashboard">Dashboard</a></li>
          {user
            ? <li><a href="/session" data-user={user.username}>{user.username}</a></li>
            : <><li><a href={`/session?next=${next}`}>Log in</a></li><li><a href={`/user?next=${next}`}>Sign up</a></li></>}
          <li><button type="button" class="outline secondary" data-theme-toggle aria-label="Switch light or dark theme">◐</button></li>
        </ul>
      </nav>
    </header>
    <main class="container"><slot /></main>
    <script is:inline>
      document.querySelector("[data-theme-toggle]").addEventListener("click", () => {
        // Purpose: flip between light and dark, starting from whatever is showing now, and remember it
        const html = document.documentElement
        const current = html.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        html.dataset.theme = current === "dark" ? "light" : "dark"
        try { localStorage.setItem("theme", html.dataset.theme) } catch {}
      })
    </script>
  </body>
</html>

<style is:global>
  .ok { color: var(--pico-ins-color); }
  .bad { color: var(--pico-del-color); }
  .pre { white-space: pre-wrap; }
  .md > p:only-child, .prompt > p:only-child { margin: 0; }
  label.option { display: block; }
  select.slot { display: inline-block; width: auto; height: auto; margin: 0; padding: 0 2rem 0 0.4rem; }
</style>
