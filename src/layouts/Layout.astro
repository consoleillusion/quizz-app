---
// Page shell: wacss styles plain HTML through one global stylesheet; the palette and mode are attributes on <html>.
import "wacss/wacss.css"
import NavBar from "wacss/components/NavBar/NavBar.astro"
import Page from "wacss/components/Page/Page.astro"

interface Props {
  title: string
  description?: string
}
const { title, description = "Cisco certification practice quizzes" } = Astro.props
const user = Astro.locals.user
const path = Astro.url.pathname
const next = encodeURIComponent(path)
// The palette every page uses; the names are in wacss's palettes.dhall.
const palette = "matcha"
const links = [
  { href: "/", label: "Exams" },
  { href: "/dashboard", label: "Dashboard" },
]
const account = user
  ? [{ component: "Link", data: { href: "/session", label: user.username, "data-user": user.username } }]
  : [
      { component: "Link", data: { href: `/session?next=${next}`, label: "Log in" } },
      { component: "Link", data: { href: `/user?next=${next}`, label: "Sign up" } },
    ]
---
<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline>
      // Apply the saved mode before first paint; wacss follows the system setting when none is saved.
      try { const mode = localStorage.getItem("wacss:mode"); if (mode) document.documentElement.dataset.mode = mode } catch {}
    </script>
    <title>{title} · Exam Practice</title>
  </head>
  <Page data-user-id={user?.id}>
    <NavBar
      title="Exam Practice"
      href="/"
      current={path}
      links={links}
      end={[...account, { component: "Button", data: { id: "mode", variant: "tertiary", "aria-live": "polite" } }]}
    />
    <main class="center stack box"><slot /></main>
    <script>
      const root = document.documentElement
      const button = document.getElementById("mode")!
      const isLight = () =>
        // Purpose: the mode in effect: the one chosen, else the system's
        root.dataset.mode ? root.dataset.mode === "light" : matchMedia("(prefers-color-scheme: light)").matches
      const show = () => {
        // Purpose: say which mode is on
        button.textContent = isLight() ? "☀ Light mode on" : "☾ Dark mode on"
      }
      button.addEventListener("click", () => {
        // Purpose: switch to the other mode and remember it
        root.dataset.mode = isLight() ? "dark" : "light"
        try { localStorage.setItem("wacss:mode", root.dataset.mode) } catch {}
        show()
      })
      show()
    </script>
  </Page>
</html>

<style is:global>
  /* Answer feedback: an intent tint with its text derived from it, as wacss derives a component's text. */
  .ok, .bad { color: oklch(from var(--tint) calc(1 - l) c h); background: var(--tint); }
  .ok { --tint: var(--color-positive-tint); }
  .bad { --tint: var(--color-danger-tint); }
  /* Wide tables scroll inside their own box. */
  .scroll { overflow-x: auto; }
</style>
